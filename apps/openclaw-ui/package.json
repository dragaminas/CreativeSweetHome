    "@types/node": "latest",
    "eslint": "latest",
    "eslint-plugin-svelte": "latest",
    "globals": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "tslib": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
